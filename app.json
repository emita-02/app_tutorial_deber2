{
  "expo": {
    "name": "app_deber2",
    "slug": "app_deber2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-epn.png",
    "scheme": "appdeber2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-epn.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002A5C",
        "foregroundImage": "./assets/images/icon-epn.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-epn.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002A5C",
          "image": "./assets/images/BUHO_EPN.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
